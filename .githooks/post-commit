#!/usr/bin/env bash
# Auto-redeploy the web app whenever a commit lands on main.
set -euo pipefail

branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" != "main" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Only redeploy when something under web/ actually changed in the just-made commit.
if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^(web/|compose\.yml$|scripts/deploy-web\.sh$)'; then
    exit 0
fi

echo "[post-commit] web/ changed on main — redeploying..."
# Run detached so the commit returns immediately.
nohup "$REPO_ROOT/scripts/deploy-web.sh" >"$REPO_ROOT/.git/deploy-web.log" 2>&1 &
disown || true
echo "[post-commit] deploy started in background (log: .git/deploy-web.log)"
