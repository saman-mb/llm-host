[Unit]
Description=ComfyUI (ROCm) image-generation server on Strix Halo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/ComfyUI
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
ExecStart=%h/dev/ComfyUI/.venv/bin/python main.py --listen 127.0.0.1 --port 8188 --disable-mmap --bf16-vae --cache-none --use-pytorch-cross-attention
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.local/share/comfyui.log
StandardError=append:%h/.local/share/comfyui.log

[Install]
WantedBy=default.target
