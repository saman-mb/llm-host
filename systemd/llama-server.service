[Unit]
Description=llama-server (Vulkan toolbox on Strix Halo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/dev/llm-host/bin/serve
Restart=always
RestartSec=10
StandardOutput=append:%h/.local/share/llama-server.log
StandardError=append:%h/.local/share/llama-server.log

[Install]
WantedBy=default.target
