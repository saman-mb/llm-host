[Unit]
Description=llama-swap — on-demand model router (Vulkan toolbox on Strix Halo)
# On-demand model router for multi-model setups. llama-swap listens on
# :8080 and spawns llama-server inside the toolbox on demand, swapping models
# when the requested model id changes.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/llama-swap --config %h/dev/llm-host/llama-swap.yaml
Restart=on-failure
RestartSec=10

# --- OOM & memory guardrails (W4) ---
# Push llama-swap (and its llama-server children) to front of OOM kill queue.
OOMScoreAdjust=200
# Soft memory ceiling — systemd signals the cgroup to reclaim before hard kill.
MemoryHigh=120G

# --- Logging ---
# Logs go to journald. Cap total journal usage with:
#   systemd/journald.conf.d-llm-host.conf  →  /etc/systemd/journald.conf.d/llm-host.conf
#   (SystemMaxUse=500M — see that file for install instructions)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-swap

[Install]
# To enable:
#   systemctl --user enable --now llama-swap.service
# (Uncomment the line below and run the above command.)
WantedBy=default.target
